{
  "name": "vortex-cart",
  "version": "0.1.0",
  "private": true,
  "description": "Vortex Cart — app mobile para registrar compras de mercado e comparar gastos entre supermercados.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export -p web",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform all",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-status-bar": "~1.12.0",
    "expo-sqlite": "~14.0.0",
    "expo-file-system": "~17.0.0",
    "expo-sharing": "~12.0.0",
    "expo-print": "~13.0.0",
    "expo-document-picker": "~12.0.0",
    "expo-secure-store": "~13.0.0",
    "expo-font": "~12.0.0",
    "expo-splash-screen": "~0.27.0",
    "expo-linking": "~6.3.0",
    "expo-constants": "~16.0.0",
    "@expo-google-fonts/raleway": "^0.2.3",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-svg": "15.2.0",
    "zustand": "^4.5.2",
    "react-hook-form": "^7.51.5",
    "@hookform/resolvers": "^3.4.2",
    "zod": "^3.23.8",
    "@expo/vector-icons": "^14.0.0",
    "react-dom": "18.2.0",
    "react-native-web": "~0.19.10",
    "@expo/metro-runtime": "~3.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "@types/jest": "^30.0.0",
    "typescript": "~5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^7.1.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-prettier": "^5.1.3",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "prettier": "^3.3.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "jest": "^30.5.1",
    "jest-expo": "~51.0.0",
    "@testing-library/react-native": "^12.5.1",
    "@testing-library/jest-native": "^5.4.3",
    "react-test-renderer": "18.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
